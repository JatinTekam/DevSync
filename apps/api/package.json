{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env.development --import=tsx --watch src/server.ts",
    "build": "cross-env NODE_ENV=development prisma generate && tsc",
    "build:prod": "cross-env NODE_ENV=production prisma generate && tsc",
    "start": "node --env-file=.env.production dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^5.1.0",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vitest": "^5.1.1"
  }
}